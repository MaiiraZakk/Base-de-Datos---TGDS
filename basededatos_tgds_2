CREATE DATABASE BaseDeDatos_TGDS;

//CREACIÓN DE TABLAS

–Tablas Usuarios

CREATE TABLE usuario (
    id_usuario INT NOT NULL PRIMARY KEY AUTO_INCREMENT,
    nombre VARCHAR(50) NOT NULL,
    apellido VARCHAR(50) NOT NULL,
    documento VARCHAR(8) NOT NULL UNIQUE, 
    email VARCHAR(100) NOT NULL UNIQUE
);

CREATE TABLE usuario_cliente (
    id_usuario INT NOT NULL,
    	FOREIGN KEY (id_usuario)
        REFERENCES usuario(id_usuario)
);

(// SE ELIMINA EL DATO C.I. YA QUE ES REDUNDANTE, TENEMOS Documento EN LA TABLA USUARIO)

CREATE TABLE usuario_administrador_taller (
    id_usuario INT NOT NULL,
        FOREIGN KEY (id_usuario)
        REFERENCES usuario(id_usuario)
);

MODIFICACIONES NECESARIAS QUE SE IMPLEMENTAN:

ALTER TABLE usuario
ADD COLUMN tipo_usuario ENUM('Cliente', 'Administrador')
NOT NULL DEFAULT 'Cliente';

//Agregamos una columna que indicará que tiempo de Usuario se está ingresando (Administrador o Cliente). Todos los usuarios quedarán como Clientes por eso se realizará otra modificación:

UPDATE usuario
SET tipo_usuario = 'Administrador'
WHERE id_usuario IN (2, 3, 6, 8, 10);

// Agregamos la columna “password” para guardar las contraseñas de los usuarios logueados.

ALTER TABLE usuario
ADD COLUMN password VARCHAR(255) NOT NULL;
// Se identifica de forma más clara y precisa al Administrador del Taller y el Administrador del Sistema para poder crear las funcionalidades de cada uno.

ALTER TABLE usuario
MODIFY COLUMN tipo_usuario
ENUM('Cliente', 'Administrador_Taller', 'Administrador_Sistema')
NOT NULL DEFAULT 'Cliente';

Tabla: usuario_administrador_sistema.

CREATE TABLE usuario_administrador_sistema (
    id_usuario INT NOT NULL PRIMARY KEY,
    
    FOREIGN KEY (id_usuario)
        REFERENCES usuario(id_usuario)
);


--Tabla talleres
CREATE TABLE talleres (
    id_taller INT NOT NULL PRIMARY KEY AUTO_INCREMENT,
    nombre VARCHAR(50) NOT NULL,
    numero_puerta INT NOT NULL,
    calle VARCHAR(30) NOT NULL,
    ciudad VARCHAR(30) NOT NULL,
    email VARCHAR(50) NOT NULL UNIQUE,
    rut VARCHAR(12) NOT NULL UNIQUE,
    hora_apertura TIME NOT NULL, 
    hora_cierre TIME NOT NULL
);

   ** horario_atencion VARCHAR(20) NOT NULL  // Creemos que conviene separar “horario_atencion” por: hora_apertura TIME, hora_cierre TIME 

// Agregamos a la Table Tallers id_administrador para que el administrador del taller pueda visualizar la información de su Taller.

ALTER TABLE talleres
ADD COLUMN id_administrador INT NULL UNIQUE,
ADD CONSTRAINT fk_taller_administrador
FOREIGN KEY (id_administrador)
REFERENCES usuario(id_usuario);


--Tabla vehículos
CREATE TABLE vehiculos (
    id_vehiculo INT NOT NULL PRIMARY KEY AUTO_INCREMENT,
    marca VARCHAR(30) NOT NULL,
    modelo VARCHAR(30) NOT NULL,
    color VARCHAR(30) NOT NULL,
    kilometraje INT NOT NULL,
    anio INT NOT NULL,
    matricula VARCHAR(8) NOT NULL UNIQUE
);


--Tabla mecánicos
CREATE TABLE mecanico (
    id_mecanico INT PRIMARY KEY AUTO_INCREMENT,
    especialidad VARCHAR(50) NOT NULL,
    email VARCHAR(50) NOT NULL UNIQUE,
    nombre VARCHAR(50) NOT NULL,
    apellido VARCHAR(50) NOT NULL,
    salario FLOAT NOT NULL,
    fecha_ingreso DATE NOT NULL,
    id_taller INT NOT NULL,
    FOREIGN KEY (id_taller) REFERENCES talleres(id_taller)
);

// Se relacionan los mecánicos con los talleres donde trabajan mediante una clave foránea (ya que serán varios talleres) así cada mecánico quedará asociado a un taller, permitiendo consultar Que mecánico es del taller. Cantidad de mecánicos por taller. Reservas y reparaciones asignadas a un taller específico.

id_taller INT NOT NULL,
FOREIGN KEY (id_taller) REFERENCES talleres(id_taller)


-- Tabla Servicios
CREATE TABLE servicios (
    id_servicio INT NOT NULL PRIMARY KEY AUTO_INCREMENT ,
    nombre_servicio VARCHAR(50) NOT NULL,
    descripcion_servicio VARCHAR(255) NOT NULL,
    costo_primario FLOAT NOT NULL
);

-- Tabla reservas
CREATE TABLE reservas (
    id_reserva INT NOT NULL PRIMARY KEY AUTO_INCREMENT,
    codigo_reserva VARCHAR(10) NOT NULL UNIQUE,
    id_usuario INT NOT NULL,
    id_vehiculo INT NOT NULL,
    id_taller INT NOT NULL,
    fecha DATE NOT NULL,
    hora TIME NOT NULL,

    estado_reserva ENUM(
        'Pendiente',
        'Confirmada',
        'Cancelada',
        'Finalizada'
    ) NOT NULL DEFAULT 'Pendiente', //si no se asigna estado, por defecto queda Pendiente.

    motivo_cancelacion VARCHAR(255) NULL,

    FOREIGN KEY (id_usuario)
        REFERENCES usuario_cliente(id_usuario),

    FOREIGN KEY (id_vehiculo)
        REFERENCES vehiculos(id_vehiculo),

    FOREIGN KEY (id_taller)
        REFERENCES talleres(id_taller)
);

// Consideramos más útil que la tabla reparaciones represente cada reparación realizada y se relacione con las demás tablas mediante claves foráneas.

-- TABLA REPARACIONES
CREATE TABLE reparaciones (
    id_reparacion INT PRIMARY KEY AUTO_INCREMENT,
    id_vehiculo INT NOT NULL,
    id_mecanico INT NOT NULL,
    id_servicio INT NOT NULL,
    id_reserva INT NOT NULL,
    fecha_inicio DATE,
    fecha_fin DATE,
    demora_estimada VARCHAR(20),
    observaciones VARCHAR(255),

    FOREIGN KEY (id_vehiculo)
        REFERENCES vehiculos(id_vehiculo),

    FOREIGN KEY (id_mecanico)
        REFERENCES mecanico(id_mecanico),

    FOREIGN KEY (id_servicio)
        REFERENCES servicios(id_servicio),

    FOREIGN KEY (id_reserva)
        REFERENCES reservas(id_reserva)
);

(Con esto se puede saber, qué vehículo fue reparado, qué mecánico realizó el trabajo, qué servicio se efectuó, a qué reserva corresponde y cuándo comenzó y terminó la reparación.)

-- Tabla facturas
CREATE TABLE facturas (
    id_factura INT NOT NULL PRIMARY KEY AUTO_INCREMENT,
    id_reparacion INT NOT NULL,
    monto_total FLOAT NOT NULL,
    fecha DATE NOT NULL,
	FOREIGN KEY (id_reparacion) 
		REFERENCES reparaciones(id_reparacion) 
);

-- Tabla pagos     //Se agregó la relación entre pagos y facturas mediante una clave foránea. De esta manera queda indicado qué factura corresponde a cada pago.

CREATE TABLE pagos (
    id_pago INT NOT NULL PRIMARY KEY AUTO_INCREMENT,
    id_factura INT NOT NULL,
    metodo_pago ENUM(
        'Efectivo',
        'Debito',
        'Credito',
        'Transferencia'
    ) NOT NULL,
    tarjetas_admitidas VARCHAR(100) NULL,
    fecha_pago DATE NOT NULL,
    monto_pagado FLOAT NOT NULL,
        FOREIGN KEY (id_factura)
        REFERENCES facturas(id_factura)
);

